# telegram-agent settings, read by dispatcher.py on every loop (no restart needed).
# Values in <angle brackets> are placeholders: replace them. Not a secret file, but it holds ids.

# --- Who is who --------------------------------------------------------------------------
# Owner's personal Telegram account: numeric user id (get_me from that account, or ask @userinfobot).
# Messages from this id run in "owner" mode (all tools); everyone else is a "guest".
OWNER_ID=<owner_user_id>
# Shown to the bot in its prompt (how to recognise and address the owner).
OWNER_NAME=<Owner first name>
OWNER_USERNAME=@<owner_username>
# The account the bot runs as (the one logged in to telegram-mcp): its own id is never answered.
SELF_ID=<bot_account_user_id>
# How the bot calls that account in its prompt (display name or @username).
ACCOUNT_NAME=<bot account name>
# Where secretary notifications go: the owner's id (recommended) or "me" = the bot account's Saved Messages.
NOTIFY_CHAT=<owner_user_id>

# --- Persona (the rest of the persona lives in prompt.md) --------------------------------
BOT_NAME=Нейросетевой Doom bot

# --- Model and limits ---------------------------------------------------------------------
MODEL=claude-sonnet-5-5
MAX_TURNS=15
RUN_TIMEOUT=300
# Owner tasks can be big (read a whole topic, write a long summary): own limits.
OWNER_MAX_TURNS=40
OWNER_RUN_TIMEOUT=900
# Max tokens one Telegram tool result may return in owner runs (Claude Code default 25000;
# a 300-message forum topic is ~90k). Bigger results are saved to a file and read in parts.
OWNER_MCP_OUTPUT_TOKENS=150000
# Anti-flood: max agent runs per chat per hour, and in total per hour.
PER_CHAT_PER_HOUR=20
TOTAL_PER_HOUR=80
# Messages older than this many seconds are not answered (e.g. after downtime).
MAX_AGE=1800

# --- Groups -------------------------------------------------------------------------------
# Groups where the bot answers by itself = chats added to this Telegram folder on the bot
# account (the owner manages it by asking the bot in DM), plus the ids listed in GROUPS.
GROUPS_FOLDER=Doom: группы
# Extra groups by hand: numeric chat ids, comma-separated (e.g. -1001234567890).
GROUPS=
# In those groups the bot answers a reply to its message, an @mention, or a message containing
# one of these words (case-insensitive, whole word).
GROUP_TRIGGERS=Думбот,Джарвис,<ACCOUNT_NAME>,бот

# --- Optional -----------------------------------------------------------------------------
# Folder the MCP file tools may use (must match TELEGRAM_ALLOWED_ROOTS in telegram-mcp.service).
#FILES_DIR=~/TelegramMCP
# Path to the claude binary (default: ~/.local/bin/claude, then PATH).
#CLAUDE_BIN=/usr/local/bin/claude
# Safety net for messages the live stream lost (network drop, reconnect, server restart):
# every N seconds read the newest messages of the M most recent chats and of every allowed group.
#RECONCILE_INTERVAL=180
#RECONCILE_CHATS=15
# Restart telegram-mcp when only that safety net finds messages (two passes, no live events
# in between): its update stream is stuck. At most once per 30 min. 0 = never.
#RESTART_STALLED_MCP=1
