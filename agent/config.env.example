# telegram-agent settings: ~/.config/telegram-agent/config.env, re-read on every loop (no restart).
# Values in <angle brackets> are placeholders: replace them. Not a secret file, but it holds ids.

# --- Who is who --------------------------------------------------------------------------
# Owner's personal Telegram account: numeric user id. Their private chat with the bot account
# runs in "owner" mode (the whole account); everyone else, and every group, only their own chat.
OWNER_ID=<owner_user_id>
# How the bot knows and addresses the owner (only the owner's own runs see these).
OWNER_NAME=<Owner first name>
OWNER_USERNAME=@<owner_username>
# The account the bot runs as (logged in to telegram-mcp): numeric id, and how the bot calls it.
SELF_ID=<bot_account_user_id>
ACCOUNT_NAME=<bot account name>
# Where notify_owner summaries go (default: OWNER_ID; "me" = the bot account's Saved Messages).
#NOTIFY_CHAT=<owner_user_id>

# --- Persona (the rest is in agent/prompts/; put your own persona.md next to this file) ----
BOT_NAME=Нейросетевой Doom bot

# --- Agent ----------------------------------------------------------------------------------
# claude | codex | opencode | command (docs/DESIGN.md#harnesses)
HARNESS=claude
MODEL=claude-sonnet-5-5
MAX_TURNS=15
RUN_TIMEOUT=300
# The owner's tasks can be big (read a whole topic, write a long summary): own limits.
OWNER_MAX_TURNS=40
OWNER_RUN_TIMEOUT=900
# Runs per hour: per guest chat, all guests together, the owner (a separate budget).
PER_CHAT_PER_HOUR=20
TOTAL_PER_HOUR=80
OWNER_PER_HOUR=60
# Messages older than this many seconds are not answered (e.g. after downtime).
MAX_AGE=1800
# Public web search (DuckDuckGo, no key) in every run; empty = off.
WEB_SEARCH=duckduckgo
# Opening web links (open_url): owner = only runs the owner started (their DM, or a group message
# from them); all = every run (a guest can then learn the server's IP from their own site's log);
# empty = off. Only links the run has seen can be opened, and only public addresses.
OPEN_URL=owner
# If the router's DNS answers with stand-in addresses for sites it reaches through a proxy
# (fake-ip, e.g. Podkop/sing-box: 198.18.0.0/15), list them so such sites can be opened too.
OPEN_URL_PROXY_NETS=

# --- Groups -------------------------------------------------------------------------------
# Groups where the bot answers = chats added to this Telegram folder on the bot account (the
# owner manages it by asking the bot in DM), plus the numeric ids in GROUPS.
GROUPS_FOLDER=Doom: группы
GROUPS=
# There the bot answers a reply to its message, an @mention, or one of these words.
GROUP_TRIGGERS=Думбот,Джарвис,бот

# --- Relays -------------------------------------------------------------------------------
# Forward every new message of one chat to another, without the model (works for bots and
# channels too; the source is then never answered). Space-separated rules, numeric ids:
#   SOURCE>TARGET[:TOPIC][~REGEX]   REGEX: case-insensitive, matched in the text and link URLs.
# A relay_review.md next to this file makes the bot comment on each relayed message in the
# target topic, following that file (docs/OPERATIONS.md, «Пересылка»).
#RELAYS=<source_chat_id>><group_id>:<topic_id>~avito\.ru/\d{6,}
RELAYS=

# --- Optional -----------------------------------------------------------------------------
# Folder for exports the owner's runs may read (= TELEGRAM_ALLOWED_ROOTS of telegram-mcp.service).
#FILES_DIR=~/TelegramMCP
# Paths of the agent CLIs (default: the usual install locations, then PATH).
#CLAUDE_BIN=~/.local/bin/claude
#CODEX_BIN=~/.local/bin/codex
#OPENCODE_BIN=~/.opencode/bin/opencode
# OpenCode: time to the provider's response headers (ms); a run that fails on it is retried
# once with 300000. Optional stream inactivity timeout.
#OPENCODE_HEADER_TIMEOUT_MS=20000
#OPENCODE_CHUNK_TIMEOUT_MS=900000
# HARNESS=command: your own runner (gets TG_MCP_URL, TG_MODEL, TG_MAX_TURNS, prompt on stdin).
#HARNESS_COMMAND=/home/user/.local/bin/my-telegram-runner
# Safety net for messages the live stream lost: every N s read the M most recent private
# chats and every allowed group.
#RECONCILE_INTERVAL=180
#RECONCILE_CHATS=50
# Long tool results are cut into pages of this many characters (read_result).
#PAGE_CHARS=30000
#MCP_URL=http://127.0.0.1:8765/mcp
