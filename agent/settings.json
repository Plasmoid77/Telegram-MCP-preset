{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__telegram__.*|Read|Edit|Write",
        "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/guard.py\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__telegram__.*",
        "hooks": [{"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/reflow.py\""}]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "env": {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"}
}
