[Unit]
Description=telegram-mcp shared MCP server (HTTP, 127.0.0.1:8765, all tools)
Documentation=https://github.com/chigwell/telegram-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/telegram-mcp
# Secrets (API id/hash, session) live in .env (mode 600), loaded by the server itself.
Environment=MCP_TRANSPORT=http
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8765
Environment=TELEGRAM_EXPOSED_TOOLS=all
# File tools may only touch this folder (server roots only; client roots ignored)
Environment=TELEGRAM_ALLOWED_ROOTS=%h/TelegramMCP
Environment=TELEGRAM_SERVER_ROOTS_ONLY=1
# Ask Telegram for updates missed during network drops every 120 s (empty answer if none);
# the server also catches up right after each reconnect (telegram-mcp >= v3.3.23)
Environment=TELEGRAM_CATCH_UP_INTERVAL=120
# Long tools (view_video, big history reads) may take up to this long
Environment=TELEGRAM_TOOL_TIMEOUT_SECONDS=180
# Voice messages -> local asr-server (OpenAI-compatible); listings prefetch up to 5 voices per call
Environment=TELEGRAM_TRANSCRIBE=auto
Environment=TELEGRAM_TRANSCRIBE_ENGINE=openai
Environment=TELEGRAM_TRANSCRIBE_OPENAI_URL=http://127.0.0.1:5093/v1
Environment=TELEGRAM_TRANSCRIBE_OPENAI_MODEL=gigaam-v3-e2e-rnnt
Environment=TELEGRAM_TRANSCRIBE_LANGUAGE=ru
ExecStart=%h/.local/share/telegram-mcp/.venv/bin/python main.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
