[Unit]
Description=Telegram auto-responder: settled incoming messages -> one headless agent run each
Documentation=https://github.com/Plasmoid77/Telegram-MCP-preset
Requires=telegram-mcp.service
After=telegram-mcp.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=TG_AGENT_CONFIG_DIR=@CONFIG_DIR@
Environment=TG_AGENT_STATE_DIR=@STATE_DIR@
# Harness credentials (optional, mode 600): see agent/backend.env.example
EnvironmentFile=-@CONFIG_DIR@/backend.env
ExecStart=/usr/bin/python3 -I @AGENT_DIR@/agent/dispatcher.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
