[Unit]
Description=Check for a new telegram-mcp release (report only: journal + Telegram message, installs nothing)
Documentation=https://github.com/Plasmoid77/Telegram-MCP-preset
After=network-online.target telegram-mcp.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=TG_AGENT_CONFIG_DIR=@CONFIG_DIR@
Environment=TG_AGENT_STATE_DIR=@STATE_DIR@
ExecStart=/usr/bin/python3 -I @AGENT_DIR@/agent/update_mcp.py check
