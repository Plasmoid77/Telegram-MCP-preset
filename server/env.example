# Secrets for telegram-mcp (~/.local/share/telegram-mcp/.env, mode 600). Upstream format:
# https://github.com/chigwell/telegram-mcp#3-configure-environment
# Fill these in YOURSELF, never through a chat with an AI.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# After login + migration (docs/INSTALL.md, step 4) the server uses a file session:
# TELEGRAM_SESSION_NAME=/home/<user>/.local/share/telegram-mcp/telegram_mcp_session
# Optional, voice transcription (upstream "Voice transcription" section):
# GROQ_API_KEY=
